# Copie para .env.local (ignorado pelo git) e preencha com os dados do projeto Supabase.
# Supabase → Project Settings → API (ou "API Keys").

# Públicas (podem ir para o navegador)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# SECRETA — só no servidor. Usada pelo admin para criar usuários, redefinir senha e bloquear acesso.
# Nunca use o prefixo VITE_ nela nem a coloque no .env versionado.
SUPABASE_SERVICE_ROLE_KEY=

# SECRETA — só no servidor. Leitura automática do comprovante (Google AI Studio → Get API key).
GEMINI_API_KEY=
# Opcional: troca o modelo usado na leitura (padrão: gemini-3.5-flash-lite).
# GEMINI_MODEL=
